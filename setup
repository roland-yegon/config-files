#!/usr/bin/env bash
# Arch post-install setup for Roland. Safe to re-run.
set -Eeuo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

say()  { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m[!] %s\033[0m\n' "$*" >&2; }

if [[ $EUID -eq 0 ]]; then
    echo "Don't run this as root. Run it as your normal user (it calls sudo itself)." >&2
    exit 1
fi

# Helper: clone a repo, or update it if it's already there
clone_or_pull() {
    local url="$1" dest="$2"
    if [[ -d "$dest/.git" ]]; then
        git -C "$dest" pull --ff-only || warn "Could not update $dest"
    else
        git clone --depth 1 "$url" "$dest"
    fi
}

# Helper: append a line to ~/.bashrc only if it's not already there
add_to_bashrc() {
    grep -qxF "$1" "$HOME/.bashrc" 2>/dev/null || echo "$1" >> "$HOME/.bashrc"
}

# ---------------------------------------------------------------------------
say "Installing toolchain (official repos)"
sudo pacman -Syu --needed \
    base-devel cmake ninja rustup go gdb git gvim \
    tree fzf ripgrep btrfs-assistant \
    btop fastfetch obs-studio libreoffice-still okular mpv gwenview \
    man-pages man-db plocate tldr starship \
    ttf-jetbrains-mono-nerd \
    discord qtcreator \
    clang gopls pyright jdk-openjdk qt6-base \
    nodejs npm typescript typescript-language-server

# ---------------------------------------------------------------------------
say "Setting up git"
git config --global user.name "rolandyegon"
git config --global user.email "rolandyegon@gmail.com"
git config --global init.defaultBranch "main"

# ---------------------------------------------------------------------------
say "Setting up Rust"
rustup default stable
rustup component add rust-analyzer

# ---------------------------------------------------------------------------
say "Setting up shell (starship + Go PATH)"
touch "$HOME/.bashrc"
add_to_bashrc 'eval "$(starship init bash)"'
add_to_bashrc 'export PATH="$PATH:$(go env GOPATH)/bin"'

# ---------------------------------------------------------------------------
say "Installing yay (AUR helper)"
if command -v yay >/dev/null 2>&1; then
    echo "yay already installed, skipping."
else
    git clone https://aur.archlinux.org/yay.git "$TMP_DIR/yay"
    (cd "$TMP_DIR/yay" && makepkg -si)
fi

# ---------------------------------------------------------------------------
say "Setting up Vim"
mkdir -p "$HOME/.vim"/{undo,swap,backup}
mkdir -p "$HOME/.vim/pack/themes/start" "$HOME/.vim/pack/plugins/start"

clone_or_pull https://github.com/catppuccin/vim.git                         "$HOME/.vim/pack/themes/start/catppuccin"
clone_or_pull https://github.com/itchyny/lightline.vim.git                  "$HOME/.vim/pack/plugins/start/lightline"
clone_or_pull https://github.com/junegunn/fzf.vim.git                       "$HOME/.vim/pack/plugins/start/fzf.vim"
clone_or_pull https://github.com/LunarWatcher/auto-pairs.git                "$HOME/.vim/pack/plugins/start/auto-pairs"
clone_or_pull https://github.com/prabirshrestha/vim-lsp.git                 "$HOME/.vim/pack/plugins/start/vim-lsp"
clone_or_pull https://github.com/mattn/vim-lsp-settings.git                 "$HOME/.vim/pack/plugins/start/vim-lsp-settings"
clone_or_pull https://github.com/prabirshrestha/asyncomplete.vim.git        "$HOME/.vim/pack/plugins/start/asyncomplete.vim"
clone_or_pull https://github.com/prabirshrestha/asyncomplete-lsp.vim.git    "$HOME/.vim/pack/plugins/start/asyncomplete-lsp.vim"
clone_or_pull https://github.com/prabirshrestha/asyncomplete-buffer.vim.git "$HOME/.vim/pack/plugins/start/asyncomplete-buffer.vim"
clone_or_pull https://github.com/hrsh7th/vim-vsnip.git                      "$HOME/.vim/pack/plugins/start/vim-vsnip"
clone_or_pull https://github.com/hrsh7th/vim-vsnip-integ.git                "$HOME/.vim/pack/plugins/start/vim-vsnip-integ"
clone_or_pull https://github.com/rafamadriz/friendly-snippets.git           "$HOME/.vim/pack/plugins/start/friendly-snippets"

if [[ -f "$HOME/.vimrc" ]] && ! cmp -s "$REPO_DIR/.vimrc" "$HOME/.vimrc"; then
    cp "$HOME/.vimrc" "$HOME/.vimrc.bak"
    warn "Existing .vimrc backed up to ~/.vimrc.bak"
fi
cp "$REPO_DIR/.vimrc" "$HOME/.vimrc"

# ---------------------------------------------------------------------------
say "Installing AUR apps"
yay -S --needed \
    spotify brave-bin eclipse-java-bin visual-studio-code-bin \
    google-chrome limine-mkinitcpio-hook limine-snapper-sync anydesk-bin \
    vscode-langservers-extracted \
    || warn "Some AUR packages failed. Re-run: yay -S <package> for the ones that did."

# ---------------------------------------------------------------------------
say "Ricing with illogical impulse end-4"
bash <(curl -s https://ii.clsty.link/get)

# ---------------------------------------------------------------------------
say "All done."
warn "Manual step: open a .java file in Vim and run :LspInstallServer (Java),"
warn "then open a CMakeLists.txt and run :LspInstallServer (CMake)."
read -rp "Reboot now? [y/N] " answer
if [[ "${answer,,}" == "y" ]]; then
    reboot
fi
